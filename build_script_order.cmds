# -----------------------------------------
AddSkyBox "BREAKNECK" levels\dlc\cex_headlong\cex_headlong.scenario 0
AddSkyBox "FORGE WORLD" levels\multi\forge_halo\forge_halo.scenario 0
AddSkyBox "NEW ALEXANDRIA" levels\solo\m52\m52.scenario 0
AddSkyBox "PENANCE" levels\dlc\cex_damnation\cex_damnation.scenario 0
AddSkyBox "POWERHOUSE" levels\multi\30_settlement\30_settlement.scenario 0
AddSkyBox "RIDGELINE" levels\dlc\cex_timberland\cex_timberland.scenario 1

EditTag multiplayer\forge_globals.forge_globals_definition
AddBlockElements WeatherEffects
SetField WeatherEffects[*].Name "Rain, Reach"
SetField WeatherEffects[*].Effect m52\fx\fx_library\weather\rain\rain_angle\rain_angle.effect
SaveTagChanges
Exit

