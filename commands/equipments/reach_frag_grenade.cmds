# ------------------------
# |        PORTING       |
# ------------------------
OpenCacheFile reachmapsdir\forge_halo.map
RunCommands workingdir\commands\reach_globals.cmds

NameBlamTag objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect reach\objects\weapons\grenade\frag_grenade\fx\airborne_detonation
NameBlamTag objects\weapons\grenade\frag_grenade\fx\detonation.effect reach\objects\weapons\grenade\frag_grenade\fx\detonation
NameBlamTag objects\weapons\grenade\frag_grenade\fx\projectile.effect reach\objects\weapons\grenade\frag_grenade\fx\projectile
NameBlamTag objects\weapons\grenade\frag_grenade\frag_grenade_equipment.model reach\objects\weapons\grenade\frag_grenade\frag_grenade_equipment
NameBlamTag objects\weapons\grenade\frag_grenade\frag_grenade.model reach\objects\weapons\grenade\frag_grenade\frag_grenade
NameBlamTag objects\weapons\grenade\frag_grenade\frag_grenade.render_model reach\objects\weapons\grenade\frag_grenade\frag_grenade
NameBlamTag objects\weapons\grenade\frag_grenade\frag_grenade.collision_model reach\objects\weapons\grenade\frag_grenade\frag_grenade
NameBlamTag objects\weapons\grenade\frag_grenade\frag_grenade.physics_model reach\objects\weapons\grenade\frag_grenade\frag_grenade

PortTag reach\objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect
PortTag reach\objects\weapons\grenade\frag_grenade\fx\detonation.effect
PortTag reach\objects\weapons\grenade\frag_grenade\fx\projectile.effect
PortTag reach\objects\weapons\grenade\frag_grenade\frag_grenade_equipment.model
PortTag reach\objects\weapons\grenade\frag_grenade\frag_grenade.model
PortTag sound\weapons\frag_grenade\frag_armed_loop\frag_armed_loop.sound_looping
PortTag objects\weapons\grenade\frag_grenade\damage_effects\frag_grenade_impact.damage_effect
Exit

# ------------------------
# |        EFFECT        |
# ------------------------
# This one is more higher pitch, not noticeable outdoor but very much so indoor
EditTag reach\objects\weapons\grenade\frag_grenade\fx\detonation.effect
SetField Events[0].Parts[4].Type sound\weapons\frag_grenade\frag_expl_reach.sound
SaveTagChanges
Exit

EditTag objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect
CopyBlockElements Events[0].ParticleSystems 2 2
Exit

EditTag reach\objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect
PasteBlockElements Events[0].ParticleSystems
SaveTagChanges
Exit

EditTag objects\weapons\grenade\frag_grenade\fx\detonation.effect
CopyBlockElements Events[0].ParticleSystems 2 3
Exit

EditTag reach\objects\weapons\grenade\frag_grenade\fx\detonation.effect
PasteBlockElements Events[0].ParticleSystems
SaveTagChanges
Exit

# ------------------------
# |         MODEL        |
# ------------------------
EditTag reach\objects\weapons\grenade\frag_grenade\frag_grenade_equipment.model
SetField Materials[0].GlobalMaterialName tough
SetField Materials[0].GlobalMaterialIndex 27

SetField NewDamageInfo[0].DamageSections[1].InstantResponses[1].CustomResponseLabel headshot
SaveTagChanges
Exit

# ------------------------
# |       EQUIPMENT      |
# ------------------------
EditTag objects\weapons\grenade\frag_grenade\frag_grenade.equipment
SetField BoundingRadius 0.06595986
SetField BoundingOffset 0.00010542013 -0.0001503136 -0.00085507147
SetField Model reach\objects\weapons\grenade\frag_grenade\frag_grenade_equipment.model

SetField DetonationDelay 0.034 0.1
SetField DetonationEffect reach\objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect

SetField CampaignOnGroundScale 1.1
SetField MultiplayerOnGroundScale 1.1

SetField ItemUnitScales.SmallUnit.Armed 0.9
SetField ItemUnitScales.SmallUnit.Stowed 0.9
SetField ItemUnitScales.MediumUnit.Armed 1
SetField ItemUnitScales.MediumUnit.Stowed 1
SetField ItemUnitScales.LargeUnit.Armed 1.3
SetField ItemUnitScales.LargeUnit.Stowed 1.3
SaveTagChanges
Exit

# ------------------------
# |      PROJECTILE      |
# ------------------------
EditTag objects\weapons\grenade\frag_grenade\frag_grenade.projectile
SetField BoundingRadius 0.06595986
SetField BoundingOffset 0.00010542013 -0.0001503136 -0.00085507147
SetField SweetenerSize Medium
SetField Model reach\objects\weapons\grenade\frag_grenade\frag_grenade.model

SetField Attachments[0].Type reach\objects\weapons\grenade\frag_grenade\fx\projectile.effect
AddBlockElements Attachments
SetField Attachments[3].Type sound\weapons\frag_grenade\frag_armed_loop\frag_armed_loop.sound_looping
SetField Attachments[3].Marker smoke
SetField Attachments[3].PrimaryScale audio

SetField ArmingTime 1.4
SetField Timer 0.6 0.65

SetField AirborneDetonationEffect reach\objects\weapons\grenade\frag_grenade\fx\airborne_detonation.effect
SetField GroundDetonationEffect reach\objects\weapons\grenade\frag_grenade\fx\detonation.effect

SetField ImpactDamage objects\weapons\grenade\frag_grenade\damage_effects\frag_grenade_impact.damage_effect
SetField BoardingDetonationTime 2.5
SaveTagChanges
Exit

# ------------------------
# |     DAMAGE EFFECT    |
# ------------------------
StringId Add detonates_grenades
EditTag objects\weapons\grenade\frag_grenade\damage_effects\frag_grenade_equipment_explosion.damage_effect
SetField Radius 0.675 2.25
SetField Flags DetonatesExplosives,EnablesSpecialDeath
SetField AreaOfEffectCoreRadius 0.54
SetField DamageLowerBound 0
SetField DamageUpperBound 80 80
SetField ActiveCamoflageDamage 1
# SetField CustomResponseLabel detonates_grenades
SetField InstantaneousAcceleration 2.25
SetField RiderMinTransferDamageScale 0
SetField ShakeRadius 9
SaveTagChanges
Exit

EditTag objects\weapons\grenade\frag_grenade\damage_effects\frag_grenade_explosion.damage_effect
SetField Radius 0.675 2.25
SetField Flags DetonatesExplosives,EnablesSpecialDeath
SetField AreaOfEffectCoreRadius 0.54
SetField DamageLowerBound 0
SetField DamageUpperBound 160 160
SetField ActiveCamoflageDamage 1
# SetField CustomResponseLabel detonates_grenades
SetField InstantaneousAcceleration 2.25
SetField RiderMinTransferDamageScale 0
SetField ShakeRadius 9
SaveTagChanges
Exit

EditTag objects\weapons\grenade\frag_grenade\damage_effects\frag_grenade_boarding_explosion.damage_effect
SetField Radius 0.075 0.3
SetField EffectFlags AffectsModelTargets
SetField Flags DoesNotHurtOwner,DetonatesExplosives,EnablesSpecialDeath
SetField AreaOfEffectCoreRadius 0.1
SetField DamageLowerBound 0
SetField DamageUpperBound 3000 3000
SetField ActiveCamoflageDamage 1
# SetField CustomResponseLabel detonates_grenades
SetField InstantaneousAcceleration 2.75
SetField RiderMinTransferDamageScale 0
SetField ShakeRadius 9
SaveTagChanges
Exit