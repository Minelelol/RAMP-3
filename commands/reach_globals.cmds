# Run this script everytime you port from a reach map
# Used the forge halo tags name as a base, theres probably more in other map
SuppressErrors True
CS < workingdir\cs\PauseErrorWarningCount.cs

# Sublime Regex: \s+(?=[A-Za-z_][A-Za-z0-9_]*\\) (Use with AlignTab Package)
# ------------------------
# |     DIFF BITMAPS     | Bitmap with same tagnames but the texture are different between Reach and Base Cache
# ------------------------
