PortTag objects\weapons\support_high\stanchion\shaders\stanchion_scope_illum.shader_halogram
Exit

# ------------------------
# |        SHADER        |
# ------------------------
EditTag objects\weapons\support_high\stanchion\shaders\stanchion_composite.shader
SetArgument bump_detail_map 30 30 0 0
SetArgument bump_detail_coefficient 1.5
SetArgument diffuse_coefficient 2.2
SetArgument specular_coefficient 0.5
SetArgument fresnel_color 0.1 0.1 0.2
SetArgument roughness 0.25
SetArgument area_specular_contribution 0.4
SetArgument analytical_specular_contribution 2
SetArgument environment_map_specular_contribution 0.4
SetArgument analytical_anti_shadow_control 0.25

SetField ShaderProperties[0].Flags None
SaveTagChanges
Exit

EditTag objects\weapons\support_high\stanchion\shaders\stanchion_bipod.shader
FixHologram

SetField ShaderProperties[0].Flags None
SaveTagChanges
Exit

EditTag objects\weapons\support_high\stanchion\shaders\stanchion_magazine.shader
FixHologram

SetArgument detail_map 16 16 0 0

SetField ShaderProperties[0].Flags None
SaveTagChanges
Exit

EditTag objects\weapons\support_high\stanchion\shaders\stanchion_scope_glass_opaque.shader
SetArgument specular_coefficient 0.35
SaveTagChanges
Exit

# ------------------------
# |     RENDER MODEL     |
# ------------------------
StringId Add night_vision

CreateTag mode dw3\r3ach\objects\weapons\rifle\stanchion_rifle\stanchion_rifle
ImportTag dw3\r3ach\objects\weapons\rifle\stanchion_rifle\stanchion_rifle.render_model workingdir\tags\weapons\VKMT\sniper_rifle.render_model
EditTag dw3\r3ach\objects\weapons\rifle\stanchion_rifle\stanchion_rifle.render_model

SetField MarkerGroups[2].Name night_vision
SetField MarkerGroups[8].Name right_hand_spartan

# Primary Trigger
SetField MarkerGroups[4].Markers[0].Translation 0.5258326 -0.004026351 0.03590637

# Muzzle Brake
SetField MarkerGroups[1].Markers[0].Translation 0.5155026 0.016313653 0.04173709

RemoveBlockElements Materials 0 *
AddBlockElements Materials 8
SetField Materials[0].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_composite.shader
SetField Materials[1].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_bipod.shader
SetField Materials[2].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_magazine.shader
SetField Materials[3].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_scanlines.shader
SetField Materials[4].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_scope_glass.shader
SetField Materials[5].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_scope_glass_opaque.shader
SetField Materials[6].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_scope_overlay.shader
SetField Materials[7].RenderMethod objects\weapons\support_high\stanchion\shaders\stanchion_scope_illum.shader_halogram

RemoveBlockElements Regions 0 *
ReplaceRenderGeometry workingdir\models\weapons\STANCHION\stanchion_rifle.fbx TriangleStrip

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_spartan_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.134 -0.0031 0.0158
SetField MarkerGroups[*].Markers[*].Rotation -0.6945 0.1509 -0.337 0.6174

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_elite_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.138 -0.002 0.0112
SetField MarkerGroups[*].Markers[*].Rotation -0.438 0.135 -0.337 0.4
SaveTagChanges
Exit

