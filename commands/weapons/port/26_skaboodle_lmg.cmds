# |      HUD MESSAGE     |
# ------------------------
EditTag ui\hud\hud_messages.multilingual_unicode_string_list
SetString english lmg_picked_up "Picked up a LMG"
SetString english lmg_pickup "\uE461\uE45F to pick up|n|r\uFB08"
SetString english lmg_swap "\uE461\uE45F to swap for|n|r\uFB08"
SetString english lmg_swap_ai "\uE461\uE45F to take ally's|n|r\uFB08"
SetString english lmg_switch_to  "Out of ammo|nPress \uE446 to switch to|n|r\uFB08"
SaveTagChanges
Exit

# ------------------------
# |        WEAPON        |
# ------------------------
# have to put in potterhalo prefix so it play nice with older ramp version map
DuplicateTag objects\weapons\rifle\assault_rifle\assault_rifle.weapon potterhalo\objects\weapons\rifle\light_machine_gun\light_machine_gun
EditTag potterhalo\objects\weapons\rifle\light_machine_gun\light_machine_gun.weapon

# MELEE
SetField MeleeDamageParameters.DamagePyramidAngles 12.512375 6.061675

# AIM ASSIST
SetField WeaponAimAssist.AutoaimRange 18
SetField WeaponAimAssist.MagnetismRange 18

SetField WeaponAimAssist.AutoaimFalloffRange 10
SetField WeaponAimAssist.MagnetismFalloffRange 10

# MISC
SetField AiScariness 4
SetField ActiveCamoDing 0.2

# MAGAZINE
SetField Magazines[0].RoundsTotalInitial 240
SetField Magazines[0].RoundsTotalMaximum 360
SetField Magazines[0].RoundsLoadedMaximum 60
SetField Magazines[0].RoundsInventoryMaximum 300
SetField Magazines[0].RoundsReloaded 60

# BARREL (FIRING)
SetField Barrels[0].Firing.RoundsPerSecond 2 15
SetField Barrels[0].Firing.AccelerationTime 2
SetField Barrels[0].Firing.DecelerationTime 4

# BARREL (ERROR ANGLE)
SetField Barrels[0].ProjectileMinimumError 0.1
SetField Barrels[0].ProjectileErrorAngle 0.1 2.6

# BARREL (ACCURACY PENALTIES)
SetField Barrels[0].AccuracyPenalties.ReloadPenalty 2.5
SetField Barrels[0].AccuracyPenalties.SwitchPenalty 1

AddBlockElements Barrels[0].AccuracyPenalties.SingleWieldPenalties.FiringPenaltyFunction
AddBlockElements Barrels[0].AccuracyPenalties.SingleWieldPenalties.FiringCrouchedPenaltyFunction
SetField Barrels[0].AccuracyPenalties.SingleWieldPenalties.FiringPenaltyFunction[0].Function.Data 083400000AD7A33D0000803F0000000000000000000000000000000024000000020000000400003F713D8A3DCDB68C408BDB1C3E04000000FFFF7F7F5DEAC3BED19FF33E
SetField Barrels[0].AccuracyPenalties.SingleWieldPenalties.FiringCrouchedPenaltyFunction[0].Function.Data 0834000000000000000000000000000000000000000000000000000024000000020000000400003F713D8A3D039D3A408BDB1C3E04000000FFFF7F7F64028DBED7B7BC3E

# BARREL (RATE OF FIRE)
SetField Barrels[0].RateOfFireAccelerationTime 1.25
SetField Barrels[0].RateOfFireDecelerationTime 0.75
SetField Barrels[0].ErrorAccelerationRate 1.25
SetField Barrels[0].ErrorDecelerationRate 2

# DEPENDECIES
SetField Model dw3\r3ach\objects\weapons\rifle\light_machine_gun\light_machine_gun.model
SetField HudInterface ui\chud\light_machine_gun.chud_definition

SetField Barrels[0].Projectile dw3\r3ach\objects\weapons\rifle\light_machine_gun\projectiles\light_machine_gun_bullet.projectile
SetField Barrels[0].FiringEffects[0].FiringEffect dw3\r3ach\objects\weapons\rifle\light_machine_gun\firing.effect

ForEach FirstPerson SetField FirstPersonModel dw3\r3ach\objects\weapons\rifle\light_machine_gun\light_machine_gun.render_model
SetField FirstPerson[0].FirstPersonAnimations dw3\r3ach\objects\weapons\rifle\light_machine_gun\animations\fp_spartan\fp_spartan.model_animation_graph
SetField FirstPerson[1].FirstPersonAnimations dw3\r3ach\objects\weapons\rifle\light_machine_gun\animations\fp_elite\fp_elite.model_animation_graph

SetField PickupMessage lmg_pickup
SetField SwapMessage lmg_swap
SetField PickedUpMessage lmg_picked_up
SetField SwitchToMessage lmg_switch_to
SetField SwitchToFromAiMessage lmg_swap_ai
SaveTagChanges
Exit

# -------------------------------------------
# |                AMMO PACK                |
# -------------------------------------------
EditTag objects\equipment\ammo_pack\ammo_pack.equipment
AddBlockElements AmmoPack[0].AdditionalAmmo
SetField AmmoPack[0].AdditionalAmmo[*].Weapon potterhalo\objects\weapons\rifle\light_machine_gun\light_machine_gun.weapon
SetField AmmoPack[0].AdditionalAmmo[*].AmmoCount 60
SaveTagChanges
Exit

