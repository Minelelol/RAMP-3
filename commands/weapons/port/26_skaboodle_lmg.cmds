GenerateBitmap objects\weapons\rifle\light_machine_gun\bitmaps\lmg_diffuse workingdir\bitmaps\Weapons\Skaboodle\lmg\lmg_diffuse.dds
GenerateBitmap objects\weapons\rifle\light_machine_gun\bitmaps\lmg_zbump workingdir\bitmaps\Weapons\Skaboodle\lmg\light_machine_gun_zbump.dds Linear DXN 9

