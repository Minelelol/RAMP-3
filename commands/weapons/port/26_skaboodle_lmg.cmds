# ------------------------
# |     RENDER MODEL     |
# ------------------------
StringId Add fx_display_light

CreateTag mode dw3\r3ach\objects\weapons\rifle\light_machine_gun\light_machine_gun
ImportTag dw3\r3ach\objects\weapons\rifle\light_machine_gun\light_machine_gun.render_model workingdir\tags\weapons\VKMT\assault_rifle.render_model
EditTag dw3\r3ach\objects\weapons\rifle\light_machine_gun\light_machine_gun.render_model

SetField MarkerGroups[1].Name fx_display_light
SetField MarkerGroups[9].Name right_hand_spartan

# MUZZLE FLASH
SetField MarkerGroups[3].Markers[0].Translation 0.29783565 -0.0019027138 0.04985857
SetField MarkerGroups[3].Markers[1].Translation 0.29783565 -0.0030607223 0.046185832
SetField MarkerGroups[3].Markers[2].Translation 0.29783565 0.0019026947 0.04985857
SetField MarkerGroups[3].Markers[3].Translation 0.29783565 0 0.04400264
SetField MarkerGroups[3].Markers[4].Translation 0.29783565 0.0030786323 0.04623941

# PRIMARY EJECTION
SetField MarkerGroups[4].Markers[0].Translation 0.04018056 -0.01220891 0.040438753

# PRIMARY TRIGGER
SetField MarkerGroups[5].Markers[0].Translation 0.30342695 1.9073486E-08 0.047285505

# RIGHT HAND
SetField MarkerGroups[6].Markers[0].Translation 0.004 0 -0.0022499997

# RIGHT HAND ELITE
SetField MarkerGroups[7].Markers[0].Translation -0.005 0 0.0022499997

RemoveBlockElements Materials 0 *
AddBlockElements Materials 7
SetField Materials[0].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\light_machine_gun_metal.shader
SetField Materials[1].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\compass.shader
SetField Materials[2].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\display.shader
SetField Materials[3].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\item.shader
SetField Materials[4].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\ones.shader
SetField Materials[5].RenderMethod objects\weapons\rifle\light_machine_gun\shaders\tens.shader
SetField Materials[6].RenderMethod objects\bitmaps\decals\shaders\unsc_decals_fp.shader
RemoveBlockElements Regions 0 *
ReplaceRenderGeometry workingdir\models\weapons\lmg\lmg.fbx TriangleStrip UpdateNodes

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_spartan_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.098 -0.00226 0.0147
SetField MarkerGroups[*].Markers[*].Rotation -0.6241 0.16707 -0.45504 0.61277

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_elite_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.106 0 0.0125
SetField MarkerGroups[*].Markers[*].Rotation -0.67 0.208 -0.48 0.6
SaveTagChanges
Exit

