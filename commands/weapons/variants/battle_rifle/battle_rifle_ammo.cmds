# ------------------------
CreateTag mode dw3\r3ach\objects\weapons\rifle\battle_rifle_ammo\battle_rifle_ammo
ImportTag dw3\r3ach\objects\weapons\rifle\battle_rifle_ammo\battle_rifle_ammo.render_model workingdir\tags\weapons\VKMT\battle_rifle.render_model
EditTag dw3\r3ach\objects\weapons\rifle\battle_rifle_ammo\battle_rifle_ammo.render_model

SetField MarkerGroups[8].Name right_hand_spartan

SetField Materials[0].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_composite_blue.shader
SetField Materials[1].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_lens_blue.shader
SetField Materials[2].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_metal_blue.shader
SetField Materials[3].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_metal_shiny.shader
SetField Materials[4].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_rubber.shader
SetField Materials[5].RenderMethod objects\weapons\rifle\battle_rifle\shaders\br_carry.shader
SetField Materials[6].RenderMethod objects\bitmaps\decals\shaders\unsc_decals_fp.shader
SetField Materials[7].RenderMethod objects\weapons\rifle\dmr\shaders\dmr_lens_glass.shader

SetField Materials[8].RenderMethod objects\weapons\rifle\battle_rifle_variants\shaders\ones_br_blue.shader
SetField Materials[9].RenderMethod objects\weapons\rifle\battle_rifle_variants\shaders\tens_br_blue.shader
RemoveBlockElements Materials 10 *

RemoveBlockElements Regions 0 *
ReplaceRenderGeometry workingdir\models\weapons\BR\battle_rifle_ammo.fbx TriangleStrip

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_spartan_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.096 -0.0048 0.024
SetField MarkerGroups[*].Markers[*].Rotation -0.62 0.185 -0.44 0.625

AddBlockElements MarkerGroups
AddBlockElements MarkerGroups[*].Markers
SetField MarkerGroups[*].Name mineleloldabest_left_hand_elite_fp
SetField MarkerGroups[*].Markers[*].RegionIndex -1
SetField MarkerGroups[*].Markers[*].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.079 -0.0001 0.0182
SetField MarkerGroups[*].Markers[*].Rotation -0.598 0.1255 -0.49 0.6
SaveTagChanges
Exit

