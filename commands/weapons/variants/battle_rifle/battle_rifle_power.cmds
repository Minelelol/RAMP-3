# ------------------------
# |        SHADER        |
# ------------------------
DuplicateTag objects\weapons\rifle\battle_rifle\shaders\ones_br.shader objects\weapons\rifle\battle_rifle_variants\shaders\ones_br_gold
EditTag objects\weapons\rifle\battle_rifle_variants\shaders\ones_br_gold.shader
SetArgument self_illum_color 1 0.25 0
SetArgument self_illum_intensity 6
SaveTagChanges
Exit

DuplicateTag objects\weapons\rifle\battle_rifle\shaders\tens_br.shader objects\weapons\rifle\battle_rifle_variants\shaders\tens_br_gold
EditTag objects\weapons\rifle\battle_rifle_variants\shaders\tens_br_gold.shader
SetArgument self_illum_color 1 0.25 0
SetArgument self_illum_intensity 6
SaveTagChanges
Exit

# ------------------------
# |     RENDER MODEL     |
# ------------------------
DuplicateTag dw3\r3ach\objects\weapons\rifle\battle_rifle\battle_rifle.render_model dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power
EditTag dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.render_model
SetField Materials[0].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_composite_gold.shader
SetField Materials[1].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_lens_gold.shader
SetField Materials[2].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_metal_gold.shader
SetField Materials[3].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_metal_shiny.shader
SetField Materials[4].RenderMethod objects\weapons\rifle\dmr_variants\shaders\dmr_rubber.shader
SetField Materials[5].RenderMethod objects\weapons\rifle\dmr\shaders\dmr_lens_glass.shader
SetField Materials[6].RenderMethod objects\weapons\rifle\battle_rifle\shaders\br_carry.shader
SetField Materials[7].RenderMethod objects\bitmaps\decals\shaders\unsc_decals_fp.shader
SetField Materials[8].RenderMethod objects\weapons\rifle\battle_rifle_variants\shaders\ones_br_gold.shader
SetField Materials[9].RenderMethod objects\weapons\rifle\battle_rifle_variants\shaders\tens_br_gold.shader
SaveTagChanges
Exit

# ------------------------
# |         MODEL        |
# ------------------------
DuplicateTag dw3\r3ach\objects\weapons\rifle\battle_rifle\battle_rifle.model dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power
EditTag dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.model
SetField RenderModel dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.render_model
UpdateModelRegions phmo coll
SaveTagChanges
Exit

# ------------------------
# |        EFFECT        |
# ------------------------
DuplicateTag dw3\r3ach\objects\weapons\rifle\dmr\firing.effect dw3\r3ach\objects\weapons\rifle\battle_rifle_power\firing

EditTag objects\weapons\rifle\battle_rifle_power\fx\firing.effect
CopyBlockElements Events[0].Parts 0 *
Exit

EditTag dw3\r3ach\objects\weapons\rifle\battle_rifle_power\firing.effect
RemoveBlockElements Events[0].Parts 0 *
PasteBlockElements Events[0].Parts
SaveTagChanges
Exit

# ------------------------
# |        WEAPON        |
# ------------------------
EditTag objects\weapons\rifle\battle_rifle_power\battle_rifle_power.weapon
RemoveBlockElements ChangeColors 0 *
SetField Model dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.model
SetField FirstPerson[0].FirstPersonModel dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.render_model
SetField FirstPerson[0].FirstPersonAnimations dw3\r3ach\objects\weapons\rifle\battle_rifle\animations\fp_spartan\fp_spartan.model_animation_graph
SetField FirstPerson[1].FirstPersonModel dw3\r3ach\objects\weapons\rifle\battle_rifle_power\battle_rifle_power.render_model
SetField FirstPerson[1].FirstPersonAnimations objects\characters\dervish\fp\weapons\rifle\fp_battle_rifle\fp_battle_rifle.model_animation_graph
SetField Barrels[0].FiringEffects[0].FiringEffect dw3\r3ach\objects\weapons\rifle\battle_rifle_power\firing.effect
SaveTagChanges
Exit
