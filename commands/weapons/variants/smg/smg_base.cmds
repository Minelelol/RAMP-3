# ------------------------
# |        SHADER        |
# ------------------------
# BASE
DuplicateTag objects\weapons\rifle\dmr\shaders\dmr_metal.shader ramp\objects\weapons\rifle\smg\shaders\smg_metal
EditTag ramp\objects\weapons\rifle\smg\shaders\smg_metal.shader
SetField ShaderProperties[0].Template shaders\shader_templates\_8_2_0_1_13_1_0_0_0_5_0_0_0_0_0.render_method_template
SetField Options[0].OptionIndex 8

RemoveBlockElements ShaderProperties[0].TextureConstants 0 *
AddBlockElements ShaderProperties[0].TextureConstants 7
AddBlockElements ShaderProperties[0].RealConstants 4

SetBitmap base_map         ramp\objects\weapons\rifle\smg\bitmaps\smg_diffuse.bitmap
SetBitmap detail_map       reach\shaders\default_bitmaps\bitmaps\default_detail.bitmap
SetBitmap color_mask_map   ramp\objects\weapons\rifle\smg\bitmaps\smg_color_mask.bitmap
SetBitmap bump_map         ramp\objects\weapons\rifle\smg\bitmaps\smg_normal.bitmap
SetBitmap bump_detail_map  objects\weapons\rifle\assault_rifle\bitmaps\gun_microbump.bitmap
SetBitmap material_texture shaders\default_bitmaps\bitmaps\gray_50_percent.bitmap
SetBitmap environment_map  levels\reference\material_samples\bitmaps\cubemaps\d_cubemap_vertical_noise.bitmap
# SetBitmap self_illum_map   ramp\objects\weapons\rifle\smg\bitmaps\smg_self_illum_mask.bitmap

SetField ShaderProperties[0].TextureConstants[0].FilterMode Anisotropic2Expensive
SetField ShaderProperties[0].TextureConstants[1].TextureTransformConstantIndex 1
SetField ShaderProperties[0].TextureConstants[2].TextureTransformConstantIndex 2
SetField ShaderProperties[0].TextureConstants[3].TextureTransformConstantIndex 3
SetField ShaderProperties[0].TextureConstants[4].TextureTransformConstantIndex 4
SetField ShaderProperties[0].TextureConstants[5].TextureTransformConstantIndex 16
SetField ShaderProperties[0].TextureConstants[6].TextureTransformConstantIndex -1
# SetField ShaderProperties[0].TextureConstants[7].TextureTransformConstantIndex 28

SetArgument base_map 1 1 0 0
SetArgument detail_map 60 60 0 0
SetArgument color_mask_map 1 1 0 0
SetArgument albedo_color 1 1 0 1
SetArgument albedo_color2 1 1 1 1
SetArgument albedo_color3 1 1 1 1
SetArgument neutral_gray 1 1 1
SetArgument bump_map 1 1 0 0
SetArgument bump_detail_map 120 120 0 0
SetArgument bump_detail_coefficient 1 1 1 1
SetArgument diffuse_coefficient 0.5 0.5 0.5 0.5
SetArgument specular_color_by_angle 0 0 0 0
SetArgument specular_coefficient 1 1 1 1
SetArgument specular_tint 0.254902 0.2431373 0.20784317 0
SetArgument fresnel_color 0.11960785 0.11960785 0.11960785
SetArgument fresnel_curve_steepness 0.1 0.1 0.1 0.1
SetArgument area_specular_contribution 0.05
SetArgument analytical_specular_contribution 0.05 0 0 0
SetArgument environment_map_specular_contribution 0.05
SetArgument roughness 0.5 0.5 0.5 0.5
SetArgument analytical_roughness 0.25 0.25 0.25 0.25
SetArgument use_material_texture 0 0 0 0
SetArgument material_texture 1 1 0 0
SetArgument material_texture_black_specular_multiplier 1 1 1 1
SetArgument material_texture_black_roughness 1 1 1 1
SetArgument no_dynamic_lights 0 0 0 0
SetArgument albedo_blend 0.75 0.75 0.75 0.75
SetArgument approximate_specular_type 0.66 0.66 0.66 0.66
SetArgument env_tint_color 0.75 0.75 0.75 0
SetArgument env_roughness_scale 1 1 1 1
# SetArgument self_illum_map 1 1 0 0
# SetArgument self_illum_color 1 0 0
# SetArgument self_illum_intensity 1.5
SetArgument wet_material_dim_tint 0.8470589 0.8470589 0.9215687 1
SetArgument wet_material_dim_coefficient 1 1 1 1
SaveTagChanges
Exit

DuplicateTag ramp\objects\weapons\rifle\smg\shaders\smg_metal.shader ramp\objects\weapons\rifle\smg\shaders\smg_rubber
EditTag ramp\objects\weapons\rifle\smg\shaders\smg_rubber.shader
SetBitmap base_map ramp\objects\weapons\rifle\smg\bitmaps\smg_diffuse.bitmap
SetBitmap bump_map ramp\objects\weapons\rifle\smg\bitmaps\smg_normal.bitmap

SetBitmap detail_map      reach\objects\bitmaps\detail_maps\rubber.bitmap
SetBitmap bump_detail_map objects\weapons\rifle\assault_rifle\bitmaps\rubber_microbump.bitmap

SetBitmap color_mask_map shaders\default_bitmaps\bitmaps\color_black.bitmap
# SetBitmap self_illum_map shaders\default_bitmaps\bitmaps\color_black.bitmap

SetArgument albedo_color 1 1 1 1
SetArgument bump_detail_map 60 60 0 0
SetArgument diffuse_coefficient 1 1 1 1
SetArgument specular_tint 0.7254902 0.7843138 0.91372555
# SetArgument fresnel_color 0.08627451 0.12941177 0.22352943
SetArgument fresnel_curve_steepness 3
SetArgument area_specular_contribution 0.2
SetArgument analytical_specular_contribution 0.1
SetArgument environment_map_specular_contribution 0
# SetArgument roughness 0.5
SetArgument analytical_roughness 0.5
# SetArgument albedo_blend 0.75
SaveTagChanges
Exit

# ILLUM
DuplicateTag objects\weapons\pistol\magnum\shaders\magnum_illum.rmsh ramp\objects\weapons\rifle\smg\shaders\smg_illum
EditTag ramp\objects\weapons\rifle\smg\shaders\smg_illum.shader
SetBitmap base_map       shaders\default_bitmaps\bitmaps\color_white.bitmap
SetBitmap alpha_test_map shaders\default_bitmaps\bitmaps\color_white.bitmap
SetBitmap self_illum_map shaders\default_bitmaps\bitmaps\color_white.bitmap

SetArgument albedo_color 1 0 0 1
SetArgument self_illum_color 0.25 0 0

SetField ShaderProperties[0].BlendMode Opaque
SaveTagChanges
Exit

# MAGAZINE
DuplicateTag ramp\objects\weapons\rifle\smg\shaders\smg_metal.shader ramp\objects\weapons\rifle\smg\shaders\smg_magazine_metal
