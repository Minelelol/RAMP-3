# ------------------------
# |         MODEL        |
# ------------------------
DuplicateTag objects\weapons\rifle\smg\smg.model ramp\objects\weapons\rifle\smg\smg
EditTag ramp\objects\weapons\rifle\smg\smg.model
SetField RenderModel ramp\objects\weapons\rifle\tp_smg\tp_smg.render_model
SetField LodModel null
UpdateModelRegions phmo coll
SaveTagChanges
Exit

# ------------------------
# |        WEAPON        |
# ------------------------
EditTag objects\weapons\rifle\smg\smg.weapon
SetField Model ramp\objects\weapons\rifle\smg\smg.model
ForEach FirstPerson SetField FirstPersonModel ramp\objects\weapons\rifle\smg\smg.render_model
SaveTagChanges
Exit