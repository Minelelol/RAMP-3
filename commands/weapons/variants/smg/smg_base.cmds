# ------------------------
# |     RENDER MODEL     |
# ------------------------
CreateTag mode ramp\objects\weapons\rifle\smg\smg
ImportTag ramp\objects\weapons\rifle\smg\smg.render_model workingdir\tags\weapons\ED\smg.render_model
EditTag ramp\objects\weapons\rifle\smg\smg.render_model

RemoveBlockElements MarkerGroups 0 *

AddBlockElements MarkerGroups
SetField MarkerGroups[*].Name flashlight
AddBlockElements MarkerGroups[*].Markers 1
SetField MarkerGroups[*].Markers[0].RegionIndex -1
SetField MarkerGroups[*].Markers[0].PermutationIndex -1
SetField MarkerGroups[*].Markers[0].Translation 0.081204206 1.2060001E-09 0.027028613
SetField MarkerGroups[*].Markers[0].Rotation -1.39E-08 -4.62E-08 7.41E-08 1

AddBlockElements MarkerGroups
SetField MarkerGroups[*].Name left_hand
AddBlockElements MarkerGroups[*].Markers 1
SetField MarkerGroups[*].Markers[0].RegionIndex -1
SetField MarkerGroups[*].Markers[0].PermutationIndex -1
SetField MarkerGroups[*].Markers[*].Translation 0.018288217 0.00091953407 -0.01404753
SetField MarkerGroups[*].Markers[*].Rotation -0.13416998 -0.068389356 -0.3859059 0.9101637

AddBlockElements MarkerGroups
SetField MarkerGroups[*].Name primary_trigger
AddBlockElements MarkerGroups[*].Markers 1
SetField MarkerGroups[*].Markers[0].RegionIndex -1
SetField MarkerGroups[*].Markers[0].PermutationIndex -1
SetField MarkerGroups[*].Markers[0].Translation 0.0612042 1.371E-09 0.027029905
SetField MarkerGroups[*].Markers[0].Rotation 0 0 0 1

RemoveBlockElements Materials 0 *
AddBlockElements Materials 8
SetField Materials[0].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_metal.shader
SetField Materials[1].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_illum.shader
SetField Materials[2].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_rubber.shader
SetField Materials[3].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_magazine_metal.shader
SetField Materials[4].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_sight_metal.shader
SetField Materials[5].RenderMethod ramp\objects\weapons\rifle\smg\shaders\display.shader
SetField Materials[6].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_silencer_metal.shader
SetField Materials[7].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_laser_metal.shader

RemoveBlockElements Regions 0 *
ReplaceRenderGeometry workingdir\models\weapons\SMG\smg.fbx

SetField Regions[1].Permutations[0].MeshIndex -1
SetField Regions[2].Permutations[0].MeshIndex -1
SetField Regions[3].Permutations[0].MeshIndex -1
SetField Regions[4].Permutations[0].MeshIndex 4
SetField Regions[5].Permutations[0].MeshIndex -1

SetField Materials[4].RenderMethod null
SetField Materials[5].RenderMethod null
SetField Materials[6].RenderMethod null
SetField Materials[7].RenderMethod null
SaveTagChanges
Exit

