# ------------------------
# |         HUD          |
# ------------------------
DuplicateTag ui\chud\smg_power.chud_definition ui\chud\smg_silenced

# ------------------------
# |     RENDER MODEL     |
# ------------------------
DuplicateTag ramp\objects\weapons\rifle\smg\smg.render_model ramp\objects\weapons\rifle\smg_silenced\smg_silenced
EditTag ramp\objects\weapons\rifle\smg_silenced\smg_silenced.render_model

# Primary Trigger
SetField MarkerGroups[2].Markers[0].Translation 0.1412042 1.371E-09 0.027029905

SetField Materials[4].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_sight_metal.shader
SetField Materials[5].RenderMethod ramp\objects\weapons\rifle\smg\shaders\display.shader
SetField Materials[6].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_silencer_metal.shader
SetField Materials[7].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_laser_metal.shader

SetField Regions[1].Permutations[0].MeshIndex 1
SetField Regions[2].Permutations[0].MeshIndex 2
SetField Regions[3].Permutations[0].MeshIndex -1
SetField Regions[4].Permutations[0].MeshIndex 4
SetField Regions[5].Permutations[0].MeshIndex -1
SaveTagChanges
Exit

DuplicateTag ramp\objects\weapons\rifle\tp_smg\tp_smg.render_model ramp\objects\weapons\rifle\tp_smg_silenced\tp_smg_silenced
EditTag ramp\objects\weapons\rifle\tp_smg_silenced\tp_smg_silenced.render_model

# Primary Trigger
SetField MarkerGroups[2].Markers[0].Translation 0.16548955 0 0.024093285

SetField Materials[4].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_sight_metal.shader
SetField Materials[5].RenderMethod ramp\objects\weapons\rifle\smg\shaders\display.shader
SetField Materials[6].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_silencer_metal.shader
SetField Materials[7].RenderMethod ramp\objects\weapons\rifle\smg\shaders\smg_laser_metal.shader

SetField Regions[1].Permutations[0].MeshIndex 1
SetField Regions[2].Permutations[0].MeshIndex 2
SetField Regions[3].Permutations[0].MeshIndex -1
SetField Regions[4].Permutations[0].MeshIndex 4
SetField Regions[5].Permutations[0].MeshIndex -1
SaveTagChanges
Exit

# ------------------------
# |         MODEL        |
# ------------------------
DuplicateTag objects\weapons\rifle\smg\smg.model ramp\objects\weapons\rifle\smg_silenced\smg_silenced
EditTag ramp\objects\weapons\rifle\smg_silenced\smg_silenced.model
SetField RenderModel ramp\objects\weapons\rifle\tp_smg_silenced\tp_smg_silenced.render_model
SetField LodModel null
UpdateModelRegions phmo coll
SaveTagChanges
Exit

# ------------------------
# |       PORTING        |
# ------------------------
OpenCacheFile MCCdir\halo3odst\maps\sc150.map
NameBlamTag objects\weapons\rifle\smg_silenced\smg_silenced.model ramp\objects\weapons\rifle\smg_silenced\smg_silenced
NameBlamTag objects\weapons\rifle\smg_silenced\fp_smg_silenced\fp_smg_silenced.render_model ramp\objects\weapons\rifle\smg_silenced\smg_silenced
IgnoreBlamTag objects\characters\odst_recon\fp\weapons\rifle\fp_smg_silenced\fp_smg_silenced.model_animation_graph

PortTag objects\weapons\rifle\smg_silenced\smg_silenced.weapon
Exit

# ------------------------
# |      HUD MESSAGE     |
# ------------------------
EditTag ui\hud\hud_messages.multilingual_unicode_string_list
SetString english ssmg_picked_up "Picked up a Silenced SMG"
SetString english ssmg_pickup "\uE461\uE45F to pick up|n|r\uFB03"
SetString english ssmg_swap "\uE461\uE45F to swap for|n|r\uFB03"
SetString english ssmg_swap_ai "\uE461\uE45F to take ally's|n|r\uFB03"
SetString english ssmg_switch_to  "Out of ammo|nPress \uE446 to switch to|n|r\uFB03"
SetString english ssmg_dual "\uE461\uE45E to dual wield|n|r\uFB05"
SetString english ssmg_dual_swap "\uE461\uE45E to swap for|n|r\uFB05"
SaveTagChanges
Exit

# ------------------------
# |        WEAPON        |
# ------------------------
EditTag objects\weapons\rifle\smg_silenced\smg_silenced.weapon
SetField FirstPerson[0].FirstPersonAnimations objects\characters\masterchief\fp\weapons\rifle\fp_smg\fp_smg.model_animation_graph
SetField FirstPerson[1].FirstPersonAnimations objects\characters\dervish\fp\weapons\rifle\fp_smg\fp_smg.model_animation_graph

SetField WeaponSprintExitSpeedup 1.1
SetField SupportThirdPersonCameraRange 0 0
SetField CenteredFirstPersonWeaponOffset 0 0 -0.01
SetField WeaponTypeName offset_smg

SetField PickupMessage ssmg_pickup
SetField SwapMessage ssmg_swap
SetField PickedUpMessage ssmg_picked_up
SetField SwitchToMessage ssmg_switch_to
SetField SwitchToFromAiMessage ssmg_swap_ai
SetField PickupOrDualWieldMessage ssmg_dual
SetField SwapOrDualWieldMessage ssmg_dual_swap

SetField WeaponFlags.NewFlags LoopFPFiringAnimation,CanBeDualWielded
SaveTagChanges
Exit

# -------------------------------------------
# |                AMMO PACK                |
# -------------------------------------------
EditTag objects\equipment\ammo_pack\ammo_pack.equipment
AddBlockElements AmmoPack[0].AdditionalAmmo
SetField AmmoPack[0].AdditionalAmmo[*].Weapon objects\weapons\rifle\smg_silenced\smg_silenced.weapon
SetField AmmoPack[0].AdditionalAmmo[*].AmmoCount 48
SaveTagChanges
Exit

# ------------------------
# |      REBALANCE       |
# ------------------------
EditTag objects\weapons\rifle\smg_silenced\smg_silenced.weapon
SetField Barrels[0].DualWeaponError.DualWieldDamageScale 0.9
SetField Barrels[0].DualWeaponError.ErrorAngle 1.5 3
SetField Barrels[0].DualWeaponError.AccelerationTime 1
SetField Barrels[0].DualWeaponError.DecelerationTime 0.2
SetField Barrels[0].DualWeaponError.MinimumError 0.5
SetField Barrels[0].DualWeaponError.RuntimeAccelerationRate 1
SetField Barrels[0].DualWeaponError.RuntimeDecelerationRate 5
SaveTagChanges
Exit

# ------------------------
# | MP GLOBALS n OPTIONS |
# ------------------------
ForEach unic named: ui\halox\game_options\strings SetString English ssmg "SILENCED SMG"

SetVariable MULG_WEAPONSTRING_VAR 					ssmg
SetVariable MULG_RANDOMCHANCE_VAR 					0.1
SetVariable MULG_WEAPONTAG_VAR 						objects\weapons\rifle\smg_silenced\smg_silenced.weapon
SetVariable MULG_WEAPONSETSTRING_DUALSOVERRIDE_VAR 	ssmg
SetVariable MULG_WEAPONSETSTRING_HAMMER_VAR 		gravity_hammer
SetVariable MULG_WEAPONSETSTRING_SNIPERRIFLE_VAR 	sniper_rifle
SetVariable MULG_WEAPONSETSTRING_NOPOWERWEAPON_VAR 	ssmg
SetVariable MULG_WEAPONSETSTRING_NOSNIPERS_VAR 		ssmg
SetVariable MULG_WEAPONSETSTRING_BASEWEAP_VAR 		smg
RunCommands workingdir\commands\mainmenu\weapons_globals_n_options.cmds

