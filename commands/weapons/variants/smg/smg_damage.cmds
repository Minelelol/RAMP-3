# ------------------------
# |        SHADER        |
# ------------------------

# BASE
DuplicateTag ramp\objects\weapons\rifle\smg\shaders\smg_metal.shader ramp\objects\weapons\rifle\smg_variants\shaders\smg_metal_red
EditTag ramp\objects\weapons\rifle\smg_variants\shaders\smg_metal_red.shader
SetArgument albedo_color 2 0 0 1
SaveTagChanges
Exit

# ------------------------
# |     RENDER MODEL     |
# ------------------------
DuplicateTag ramp\objects\weapons\rifle\smg\smg.render_model ramp\objects\weapons\rifle\smg_damage\smg_damage
EditTag ramp\objects\weapons\rifle\smg_damage\smg_damage.render_model

SetField Materials[0].RenderMethod ramp\objects\weapons\rifle\smg_variants\shaders\smg_metal_red.shader

SetField Regions[1].Permutations[0].MeshIndex -1
SetField Regions[2].Permutations[0].MeshIndex -1
SetField Regions[3].Permutations[0].MeshIndex -1
SetField Regions[4].Permutations[0].MeshIndex -1
SetField Regions[5].Permutations[0].MeshIndex 5
SaveTagChanges
Exit

DuplicateTag ramp\objects\weapons\rifle\tp_smg\tp_smg.render_model ramp\objects\weapons\rifle\tp_smg_damage\tp_smg_damage
EditTag ramp\objects\weapons\rifle\tp_smg_damage\tp_smg_damage.render_model

# Primary Trigger
SetField MarkerGroups[2].Markers[0].Translation 0.11548955 0 0.028093286

SetField Materials[0].RenderMethod ramp\objects\weapons\rifle\smg_variants\shaders\smg_metal_red.shader

SetField Regions[1].Permutations[0].MeshIndex -1
SetField Regions[2].Permutations[0].MeshIndex -1
SetField Regions[3].Permutations[0].MeshIndex -1
SetField Regions[4].Permutations[0].MeshIndex -1
SetField Regions[5].Permutations[0].MeshIndex 5
SaveTagChanges
Exit

# ------------------------
# |         MODEL        |
# ------------------------
DuplicateTag objects\weapons\rifle\smg\smg.model ramp\objects\weapons\rifle\smg_damage\smg_damage
EditTag ramp\objects\weapons\rifle\smg_damage\smg_damage.model
SetField RenderModel ramp\objects\weapons\rifle\tp_smg_damage\tp_smg_damage.render_model
SetField LodModel null
UpdateModelRegions phmo coll
SaveTagChanges
Exit

# ------------------------
# |        WEAPON        |
# ------------------------
EditTag objects\weapons\rifle\smg\smg_damage.weapon
SetField Model ramp\objects\weapons\rifle\smg_damage\smg_damage.model
ForEach FirstPerson SetField FirstPersonModel ramp\objects\weapons\rifle\smg_damage\smg_damage.render_model
SaveTagChanges
Exit