# BREAKNECK
# BREAKNECK
# BREAKNECK

# ------------------------
# |        PORTING       |
# ------------------------
OpenCacheFile reachmapsdir\cex_headlong.map
SetPortingOption ReachLightmapCache "workingdir\caches\lightmapcache"
RunCommands workingdir\commands\reach_globals.cmds

NameBlamTag fx\fx_library\weather\falling_ash\falling_ash.sky_atm_parameters levels\dlc\cex_headlong\post_fx\ca_headlong_fog

IgnoreBlamTag sound\levels\dlc\cex_headlong\sound_scenery\ca_pipe_high\ca_pipe_high.sound_scenery
IgnoreBlamTag sound\levels\dlc\cex_headlong\sound_scenery\ca_pipe_med\ca_pipe_med.sound_scenery
IgnoreBlamTag sound\levels\dlc\cex_headlong\sound_scenery\ca_fluorescent_light\ca_fluorescent_light.sound_scenery

NameBlamTag objects\cex\cex_headlong\crates\physics_beam\physics_beam.crate dontputthisintheforgepalette
IgnoreBlamTag dontputthisintheforgepalette.crate

CS < workingdir\commands\map_ports\ignorescriptsource.cs
PortTag !Scripts !UpdateMapFiles *.scnr
Exit

# ------------------------
# |     KILL TRIGGER     |
# ------------------------
EditTag levels\dlc\cex_headlong\cex_headlong.scenario
SetField TriggerVolumes[1].Position -48.7387 -68.416275 25

SetField TriggerVolumes[5].Extents 14.7 21.057383 16.803665

SetField TriggerVolumes[7].Forward 1 -0.05 0
SetField TriggerVolumes[7].Extents 14.265989 5.48325 10.150548

SetField TriggerVolumes[31].Position 26.754196 -25.178934 13.504095

SetField ScenarioKillTriggers[7].TriggerVolume -1
SetField ScenarioKillTriggers[11].TriggerVolume -1
SetField ScenarioKillTriggers[12].TriggerVolume -1
SetField ScenarioKillTriggers[13].TriggerVolume -1
SetField ScenarioKillTriggers[14].TriggerVolume -1
SetField ScenarioKillTriggers[31].TriggerVolume -1
SetField ScenarioKillTriggers[32].TriggerVolume -1
SetField ScenarioKillTriggers[33].TriggerVolume -1
SetField ScenarioKillTriggers[34].TriggerVolume -1
SetField ScenarioKillTriggers[35].TriggerVolume -1
SetField ScenarioKillTriggers[39].TriggerVolume -1
SaveTagChanges
Exit

# ------------------------
# |   OBJECT PLACEMENT   |
# ------------------------
EditTag levels\dlc\cex_headlong\cex_headlong.scenario

# Fix frag grenade being sent into outer space
SetField Equipment[12].Position -9.229223 6.830332 8.955
SetField Equipment[13].Position -9.423258 6.72173 8.955
SaveTagChanges
Exit

# ------------------------
# | PODIUM/PREMATCH CAMS |
# ------------------------
EditTag levels\dlc\cex_headlong\cex_headlong.scenario
RemoveBlockElements ScriptSourceFileReferences 0 *
AddBlockElements ScriptSourceFileReferences 4
SetField ScriptSourceFileReferences[0].Instance sound\ui\scoreboard\appear_whoosh.sound
SetField ScriptSourceFileReferences[1].Instance sound\podium\third_place.sound
SetField ScriptSourceFileReferences[2].Instance sound\podium\second_place.sound
SetField ScriptSourceFileReferences[3].Instance sound\podium\first_place.sound

AddBlockElements CutsceneCameraPoints
SetField CutsceneCameraPoints[0].Position 2.679 25.204 7.673
SetField CutsceneCameraPoints[0].Orientation -90 0 0

SetField CutsceneCameraPoints[1].Name "podium_camera"
SetField CutsceneCameraPoints[1].Position 2.686 20.636 7.134
SetField CutsceneCameraPoints[1].Orientation 90 0 0
SetField CutsceneCameraPoints[1].Flags PodiumCameraHack
CompilePodiumScripts
SaveTagChanges
Exit

# ------------------------
# |        FOG/FX        |
# ------------------------
EditTag levels\dlc\cex_headlong\post_fx\ca_headlong_fog.sky_atm_parameters
SetField AtmosphereSettings[0].Intensity 2.31
SaveTagChanges
Exit

# ------------------------
# |        SHADER        |
# ------------------------
