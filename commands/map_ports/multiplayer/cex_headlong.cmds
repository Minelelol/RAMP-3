# ------------------------
# |       PARTICLE       |
# ------------------------
EditTag levels\dlc\cex_headlong\fx\flame30fps.particle
SetField ParticleBillboardStyle CameraFacing
SetField AppearanceFlags RandomUMirror,IntensityAffectsAlpha,DepthFadeActive
SaveTagChanges
Exit

EditTag levels\dlc\cex_headlong\fx\flames_fall.particle
SetField ParticleBillboardStyle CameraFacing
SetField AppearanceFlags RandomUMirror,DepthFadeActive
SaveTagChanges
Exit

# ------------------------
# |     WORLD BOUND      |
# ------------------------
EditTag levels\dlc\cex_headlong\cex_headlong.scenario_structure_bsp
SetField WorldBoundsX -175 174
SetField WorldBoundsY -318 90
SetField WorldBoundsZ -25 300
SetField Clusters[0].BoundsX -175 174
SetField Clusters[0].BoundsY -318 90
SetField Clusters[0].BoundsZ -25 300
SetField Physics.MoppBoundsMin -175 -318 -25
SetField Physics.MoppBoundsMax 174 90 300
SaveTagChanges
Exit

# ------------------------
# |    DECALS SCALING    |
