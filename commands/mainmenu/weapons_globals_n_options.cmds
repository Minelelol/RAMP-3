# SetVariable MULG_WEAPONSTRING_VAR
# SetVariable MULG_WEAPONTAG_VAR
# SetVariable MULG_WEAPONSETSTRING_DUALSOVERRIDE_VAR
# SetVariable MULG_WEAPONSETSTRING_HAMMER_VAR
# SetVariable MULG_WEAPONSETSTRING_SNIPERRIFLE_VAR
# SetVariable MULG_WEAPONSETSTRING_NOPOWERWEAPON_VAR
# SetVariable MULG_WEAPONSETSTRING_NOSNIPERS_VAR
# SetVariable MULG_WEAPONSETSTRING_BASEWEAP_VAR

# ------------------------
# |  MULTIPLAYER GLOBAL  |
# ------------------------
EditTag multiplayer\multiplayer_globals.multiplayer_globals

# FIESTA
AddBlockElements Universal[0].GameVariantWeapons 1
SetField Universal[0].GameVariantWeapons[*].Name MULG_WEAPONSTRING_VAR
SetField Universal[0].GameVariantWeapons[*].RandomChance MULG_RANDOMCHANCE_VAR
SetField Universal[0].GameVariantWeapons[*].Weapon MULG_WEAPONTAG_VAR

# WEAPON SETS (DEFAULT)
AddBlockElements Universal[0].WeaponSets[0].Substitutions
SetField Universal[0].WeaponSets[0].Substitutions[*].OriginalWeapon MULG_WEAPONSTRING_VAR
SetField Universal[0].WeaponSets[0].Substitutions[*].SubstitutedWeapon MULG_WEAPONSTRING_VAR

# WEAPON SETS (ASSAULT RIFLE)
