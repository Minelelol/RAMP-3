SetField Universal[0].WeaponSets[7].Substitutions[*].SubstitutedWeapon MULG_WEAPONSETSTRING_SNIPERRIFLE_VAR

# WEAPON SETS (ENERGY SWORD)
AddBlockElements Universal[0].WeaponSets[8].Substitutions
SetField Universal[0].WeaponSets[8].Substitutions[*].OriginalWeapon MULG_WEAPONSTRING_VAR
SetField Universal[0].WeaponSets[8].Substitutions[*].SubstitutedWeapon energy_sword

# WEAPON SETS (NO POWER WEAPONS)
AddBlockElements Universal[0].WeaponSets[9].Substitutions
SetField Universal[0].WeaponSets[9].Substitutions[*].OriginalWeapon MULG_WEAPONSTRING_VAR
SetField Universal[0].WeaponSets[9].Substitutions[*].SubstitutedWeapon MULG_WEAPONSETSTRING_NOPOWERWEAPON_VAR

# WEAPON SETS (NO SNIPERS)
