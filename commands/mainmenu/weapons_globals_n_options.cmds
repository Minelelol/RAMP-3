# WEAPON SETS (BASE)
AddBlockElements Universal[0].WeaponSets[13].Substitutions
SetField Universal[0].WeaponSets[13].Substitutions[*].OriginalWeapon MULG_WEAPONSTRING_VAR
SetField Universal[0].WeaponSets[13].Substitutions[*].SubstitutedWeapon MULG_WEAPONSETSTRING_BASEWEAP_VAR

SaveTagChanges
Exit

# ------------------------
# |     GAME OPTIONS     |
# ------------------------
EditTag multiplayer\game_variant_settings\player_traits_template\traits_weapons_initial_primary.text_value_pair_definition
AddBlockElements TextValuePairs
SetField TextValuePairs[*].ExpectedValueType StringidReference
SetField TextValuePairs[*].StringidValue MULG_WEAPONSTRING_VAR
SetField TextValuePairs[*].Name MULG_WEAPONSTRING_VAR
SaveTagChanges
Exit

